# Copy to .env (git-ignored) and change the password. Development values only.
POSTGRES_PASSWORD=
WAMIDH_DATABASE_URL=postgresql+psycopg://wamidh:wamidh-dev-only@127.0.0.1:5433/wamidh

# OpenCelliD (cell tower locations, free account at https://opencellid.org): used by
# `python -m zones.towers` to download the towers of Tunisia. Never commit the real key.
OPENCELLID_API_KEY=
# Free OpenWeatherMap key (https://openweathermap.org/api): wind at the fire for the spread
# forecast (ADR 0004). Without it the backend uses the default wind of backend/config/dev.yaml.
OPENWEATHER_API_KEY=
